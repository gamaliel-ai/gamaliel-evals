# Required for running evals. Same OpenAI key used for Gamaliel Public API (BYOK).
# Copy to .env and set your key: cp .env.example .env
OPENAI_API_KEY=

# Optional: Custom OpenAI-compatible endpoint (for bun run eval:custom)
# CUSTOM_API_BASE_URL=https://api.example.com/v1
# CUSTOM_API_KEY=
# CUSTOM_MODEL=mistral-large-latest
