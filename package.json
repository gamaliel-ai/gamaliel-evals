{
  "name": "gamaliel-evals",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "setup": "bun run scripts/check-env.ts && bun install",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
