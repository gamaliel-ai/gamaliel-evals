{
  "name": "gamaliel-evals",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "eval": "bunx promptfoo eval -c eval/promptfooconfig.yaml -j 50 --filter-providers prod",
    "eval:staging": "bunx promptfoo eval -c eval/promptfooconfig.yaml -j 50 --filter-providers staging",
    "eval:local": "bunx promptfoo eval -c eval/promptfooconfig.yaml -j 50 --filter-providers local --no-cache",
    "eval:view": "bunx promptfoo view",
    "eval:inspect": "bunx promptfoo eval -c eval/promptfooconfig.yaml -j 50 --filter-providers prod -o eval/output.html"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "promptfoo": "^0.120.25",
    "typescript": "^5.0.0"
  }
}
